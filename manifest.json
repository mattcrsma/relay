{
  "manifest_version": 3,
  "name": "Relay",
  "version": "3.1.2",
  "description": "Reviews only your SharePoint assignments and their direct related cases. No AI.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://factset.sharepoint.com/*",
    "https://rpd.factset.com/*",
    "https://factset.lightning.force.com/*",
    "https://*.logic.azure.com/*",
    "https://*.environment.api.powerplatform.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Relay",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/relay.png",
      "32": "images/relay.png"
    }
  },
  "options_page": "options.html",
  "minimum_chrome_version": "120",
  "short_name": "Relay",
  "icons": {
    "16": "images/relay.png",
    "32": "images/relay.png",
    "48": "images/relay.png",
    "128": "images/relay.png"
  }
}
